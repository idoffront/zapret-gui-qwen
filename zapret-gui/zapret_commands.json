{
    "description": "Конфигурация команд для zapret-gui (Snowy-Fluffy zapret-installer)",
    "version": "1.0",
    "note": "Для zapret-installer от Snowy-Fluffy используются ТОЛЬКО systemctl команды. Прямые команды zapret (status, start, stop) не существуют.",
    "zapret_binary": "/usr/bin/zapret",
    "commands": {
        "status": {
            "args": [],
            "description": "Проверка статуса через systemctl is-active zapret.service",
            "use_systemctl_only": true
        },
        "start": {
            "args": [],
            "description": "Запуск через systemctl start zapret.service",
            "use_systemctl_only": true
        },
        "stop": {
            "args": [],
            "description": "Остановка через systemctl stop zapret.service",
            "use_systemctl_only": true
        },
        "restart": {
            "args": [],
            "description": "Перезапуск через systemctl restart zapret.service",
            "use_systemctl_only": true
        },
        "enable": {
            "args": [],
            "description": "Включение автозапуска через systemctl enable zapret.service",
            "use_systemctl_only": true
        },
        "disable": {
            "args": [],
            "description": "Отключение автозапуска через systemctl disable zapret.service",
            "use_systemctl_only": true
        },
        "enable_autostart": {
            "args": [],
            "description": "Включение автозапуска с запуском через systemctl enable --now zapret.service",
            "use_systemctl_only": true
        },
        "disable_autostart": {
            "args": [],
            "description": "Отключение автозапуска с остановкой через systemctl disable --now zapret.service",
            "use_systemctl_only": true
        },
        "install": {
            "args": ["install"],
            "description": "Установка компонентов zapret-installer"
        },
        "uninstall": {
            "args": ["uninstall"],
            "description": "Удаление компонентов zapret-installer"
        },
        "update": {
            "args": ["update"],
            "description": "Обновление компонентов zapret-installer"
        }
    },
    "systemd_service": {
        "name": "zapret.service",
        "use_systemctl": true
    },
    "timeout_seconds": 30,
    "require_privileges": true
}
