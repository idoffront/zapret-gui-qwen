    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/zapret</annotate>
    <annotate key="org.freedesktop.policykit.exec.arg1">uninstall</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  
  <action id="io.github.snowy-fluffy.zapret-gui.update">
    <description>Обновить zapret</description>
    <message>Требуется аутентификация для обновления zapret</message>
    <message xml:lang="ru">Требуется аутентификация для обновления zapret</message>
    <icon_name>view-refresh-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/zapret</annotate>
    <annotate key="org.freedesktop.policykit.exec.arg1">update</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</node>
